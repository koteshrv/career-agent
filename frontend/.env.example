# Base URL of the backend API. Defaults to http://localhost:8000 if unset.
VITE_API_URL=http://localhost:8000

# GitHub OAuth App client ID (public, non-secret) — used for the "Sign in with GitHub"
# crowdsourcing connect button. Matches GITHUB_CLIENT_ID in the backend's .env.
VITE_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
